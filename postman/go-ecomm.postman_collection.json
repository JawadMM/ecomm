              "body": "{\n  \"data\": {\n    \"createOrder\": {\n      \"id\": \"2def4Ghij6kLMnoPQrsTUvwXyz0\",\n      \"createdAt\": \"2026-06-16T12:00:00Z\",\n      \"totalPrice\": 89.97,\n      \"products\": [\n        {\n          \"id\": \"2ghi7Jklm9nOPQrsTUvwXYz1234\",\n          \"name\": \"Widget\",\n          \"description\": \"A useful widget for everyday tasks\",\n          \"price\": 29.99,\n          \"quantity\": 3\n        }\n      ]\n    }\n  }\n}",
              "_postman_previewlanguage": "json"
            },
            {
              "name": "Duplicate Order (rejected)",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "graphql",
                  "graphql": {
                    "query": "mutation CreateOrder($input: OrderInput!) {\n  createOrder(input: $input) {\n    id\n  }\n}",
