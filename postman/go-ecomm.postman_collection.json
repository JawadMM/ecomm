            "url": { "raw": "{{baseUrl}}/graphql", "host": ["{{baseUrl}}"], "path": ["graphql"] },
            "description": "Places an order for the account. The Order service decrements catalog stock and rejects duplicate (identical-content) orders within a 60-second window. Uses the `accountId` and `productId` captured by the Create Account / Create Product requests."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
