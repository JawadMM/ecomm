            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateOrder($input: OrderInput!) {\n  createOrder(input: $input) {\n    id\n    createdAt\n    totalPrice\n    products {\n      id\n      name\n      description\n      price\n      quantity\n    }\n  }\n}",
