              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"data\": {\n    \"createAccount\": {\n      \"id\": \"2abc1Defg3hIJklMnoPQrsTuVwx\",\n      \"name\": \"Jane Doe\"\n    }\n  }\n}",
