  "item": [
    {
      "name": "Account",
      "item": [
        {
          "name": "Create Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.createAccount) {",
                  "    pm.collectionVariables.set('accountId', json.data.createAccount.id);",
                  "    pm.test('account created', () => pm.expect(json.data.createAccount.id).to.be.a('string'));",
                  "} else {",
                  "    pm.test('no errors', () => pm.expect(json.errors, JSON.stringify(json.errors)).to.be.undefined);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateAccount($input: AccountInput!) {\n  createAccount(input: $input) {\n    id\n    name\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"name\": \"Jane Doe\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Creates a new account. Captures the returned id into the `accountId` collection variable."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "graphql",
                  "graphql": {
                    "query": "mutation CreateAccount($input: AccountInput!) {\n  createAccount(input: $input) {\n    id\n    name\n  }\n}",
                    "variables": "{\n  \"input\": {\n    \"name\": \"Jane Doe\"\n  }\n}"
                  }
                },
                "url": { "raw": "{{baseUrl}}/graphql", "host": ["{{baseUrl}}"], "path": ["graphql"] }
